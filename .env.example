# Required settings are active below. Optional ones are commented out with their defaults;
# uncomment a line only to change it.

DATABASE_URL=postgres://foxtrust:foxtrust@localhost:5432/foxtrust
# Server for `bun test`: each test file creates and drops its own database there.
DATABASE_URL_TEST=postgres://foxtrust:foxtrust@localhost:5432/postgres

# --- Ingestion ---
# Tor exit lists; point it at a mirror with the same paths (deploy/tor-mirror) where torproject.org
# is blocked.
# FOXTRUST_TOR_EXIT_URL=https://collector.torproject.org/recent/exit-lists/

# --- Snapshot publishing (scheduler / `foxtrust snapshot …`) ---
# PKCS#8 PEM private key from `foxtrust keys generate`; never commit it. Without it the
# scheduler only ingests.
FOXTRUST_SIGNING_KEY=var/keys/signing.key.pem
# Public page that explains how to dispute a listing (FR-008c); publishing fails without it.
FOXTRUST_DISPUTE_URL=https://foxtrust.example/dispute

# Host path of the key that docker-compose.yml mounts as the scheduler's secret.
# FOXTRUST_SIGNING_KEY_FILE=./var/keys/signing.key.pem
# Where published files are written (served by `foxtrust publication serve`).
# FOXTRUST_PUBLICATION_DIR=var/publication
# Private staging for builds and their range tables (the base of hourly deltas).
# FOXTRUST_SNAPSHOT_WORK_DIR=var/snapshots
# Known-good reference for release reports and the regression gate.
# FOXTRUST_KNOWN_GOOD=config/accuracy/known-good.csv

# --- Operator alerts (scheduler, `foxtrust alerts test|list`) ---
# Telegram bot token and chat id; alerts are off unless both are set. Never commit the token.
# FOXTRUST_TELEGRAM_BOT_TOKEN=
# Or read the token from a file (a Docker secret); it wins over FOXTRUST_TELEGRAM_BOT_TOKEN.
# FOXTRUST_TELEGRAM_BOT_TOKEN_FILE=
# FOXTRUST_TELEGRAM_CHAT_ID=
# Bot API base URL; http:// only for loopback hosts (tests).
# FOXTRUST_TELEGRAM_API_URL=https://api.telegram.org

# --- /verify (`foxtrust verify serve`) ---
# Base URL of the publication; http:// is fine inside a private network (files are signed).
FOXTRUST_PUBLICATION_URL=http://localhost:8081
# Comma-separated base64 Ed25519 public keys; only these can verify snapshots.
FOXTRUST_TRUSTED_KEYS=
FOXTRUST_POLICY_FILE=config/policies/example.yaml

# CIDRs of reverse proxies whose X-Forwarded-For is honoured, e.g. 127.0.0.1/32,::1/128;
# empty → the header is ignored.
# FOXTRUST_TRUSTED_PROXIES=
# open → allow, closed → block when no snapshot is loaded.
# FOXTRUST_FAIL_MODE=open
# Where `challenge` sends clients: a path (e.g. /.foxtrust/challenge) turns on the built-in page,
# a URL sends them to an external page; empty → FOXTRUST_CHALLENGE_FALLBACK is used and logged.
# FOXTRUST_CHALLENGE_URL=/.foxtrust/challenge
# FOXTRUST_CHALLENGE_FALLBACK=allow
# HMAC secret for challenges and pass tokens (≥ 32 characters); required for the built-in page;
# empty → pass tokens are ignored.
# FOXTRUST_CHALLENGE_SECRET=
# Built-in page: proof-of-work bits per customer-verdict level (none = no data).
# FOXTRUST_CHALLENGE_DIFFICULTY=none=14,low=14,medium=16,high=18
# FOXTRUST_CHALLENGE_TTL_SECONDS=120
# FOXTRUST_PASS_TTL_MINUTES=30
# on → visitors without JavaScript pass by waiting (bots can take that path too).
# FOXTRUST_CHALLENGE_NOJS=off
# FOXTRUST_CHALLENGE_NOJS_WAIT_SECONDS=10
# Bot verdict of the built-in page: observe (log only, default), enforce or off.
# FOXTRUST_BOT_MODE=observe
# FOXTRUST_BOT_STEPUP=0.5
# FOXTRUST_BOT_BLOCK=0.9
# After one step-up, a session still above FOXTRUST_BOT_STEPUP: pass or block.
# FOXTRUST_BOT_AFTER_STEPUP=pass
# FOXTRUST_BOT_STEPUP_BITS=4
# Press-and-hold step shown with the challenge (behavior evidence): on (default) or off.
# FOXTRUST_BOT_HOLD=on
# Weights file; default: the newest config/bot/<version>.json.
# FOXTRUST_BOT_WEIGHTS=
# JA4 family list; default: config/bot/ja4-families.csv.
# FOXTRUST_BOT_JA4_FAMILIES=
# Returning-device token: lets a browser that passed cleanly skip the proof-of-work after its
# address changes, for up to FOXTRUST_DEVICE_CAP addresses per 24 h.
# FOXTRUST_DEVICE=on
# FOXTRUST_DEVICE_TTL_DAYS=30
# FOXTRUST_DEVICE_CAP=20
# Revocations and caps survive restarts here (no addresses are stored).
# FOXTRUST_DEVICE_STATE=var/verify/device-state.json
# Data older than this is reported as stale.
# FOXTRUST_MAX_AGE_HOURS=26
# Manifest check schedule (cron, UTC).
# FOXTRUST_UPDATE_EVERY=*/5 * * * *
# Scoring config whose codes and categories policies may use; default: the newest shipped one.
# FOXTRUST_SCORING_CONFIG=config/scoring/2026-09-30.1.json
# PORT=8080

# --- Public API (`foxtrust api serve`) ---
# Uses DATABASE_URL (accounts, keys, usage counts) and the FOXTRUST_PUBLICATION_URL,
# FOXTRUST_TRUSTED_KEYS, FOXTRUST_MAX_AGE_HOURS and FOXTRUST_UPDATE_EVERY of /verify above.
# Free-tier defaults per key: lookups per UTC day, and the burst rate per second.
# FOXTRUST_API_FREE_DAILY=1000
# FOXTRUST_API_FREE_BURST=5
# PORT=8082

# --- Public site (`foxtrust site serve`) ---
# The site's own address (no path); http:// only for 127.0.0.1 or localhost during development.
# FOXTRUST_SITE_URL=http://127.0.0.1:8084
# Hosts named in the API and snapshot docs; the trusted keys and free-tier limits above are reused.
# FOXTRUST_SITE_API_URL=https://api.foxtrust.dev
# FOXTRUST_SITE_PUBLICATION_URL=https://data.foxtrust.dev
# PORT=8084

# --- Admin panel (`foxtrust admin serve`) ---
# The panel's own address behind the tunnel (no path); redirect URIs are built from it.
# http:// only for 127.0.0.1 or localhost during development.
# FOXTRUST_ADMIN_URL=http://127.0.0.1:8083
# foxauth issuer and the panel's confidential client (project "FoxTrust Admin").
# FOXTRUST_ADMIN_ISSUER=https://auth.foxauth.dev
# FOXTRUST_ADMIN_CLIENT_ID=
# The client secret: directly, or a file (compose mounts it as a secret). Never commit it.
# FOXTRUST_ADMIN_CLIENT_SECRET=
# FOXTRUST_ADMIN_CLIENT_SECRET_FILE=
# Host path of the secret file that docker-compose.yml mounts.
# FOXTRUST_ADMIN_CLIENT_SECRET_HOST_FILE=./var/keys/admin-client-secret
# foxauth bucket group whose members may sign in.
# FOXTRUST_ADMIN_GROUP=foxtrust-operators
# PORT=8083
